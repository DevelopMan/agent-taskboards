# Agent Taskboards host configuration for Docker Compose.
#
# Copy this file to `.env` (ignored by git) and edit the values you need. Every
# setting is optional; the defaults below match a fresh checkout. Paths are
# relative to this repository root unless absolute. Paths with spaces are fine.
#
# `scripts/start-local.sh` manages every setting except TASKBOARDS_DEBUG
# interactively and preserves any other entries you add to `.env`.

# Published host port for the UI and API.
TASKBOARDS_PORT=8142

# Interface the published port binds to. `127.0.0.1` keeps the app reachable
# only from this machine. Set `0.0.0.0` to expose it on your LAN: the API and UI
# have no authentication, so anyone on the network can read and change data.
TASKBOARDS_BIND_ADDRESS=127.0.0.1

# Host directory for durable application data (the SQLite database).
TASKBOARDS_DATA_DIR=./data

# Host directory for durable uploaded or imported files.
TASKBOARDS_UPLOADS_DIR=./uploads

# Host directory holding GGUF embedding models. Mounted read-only at /models.
TASKBOARDS_MODEL_DIR=./models-gguf

# File name of the embedding model inside TASKBOARDS_MODEL_DIR. The app starts
# without it, but semantic search stays unavailable until the file exists.
TASKBOARDS_MODEL_FILE=bge-small-en-v1.5-f32.gguf

# `1` runs the Vite and API watchers for development. Leave empty for release
# mode, which builds the app and serves it from one port.
TASKBOARDS_DEBUG=1
